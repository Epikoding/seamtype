/* Araso for Windows — 한국어. macOS와 같은 문구는 Resources/ko.lproj/Localizable.strings에 있고, 여기에는 Windows에만 있는 문구만 둔다. */

/* 언어 바꾸기 키 */
"Right Alt tap" = "오른쪽 Alt 단독";
"Alt+Space" = "Alt+Space";
"Right Shift tap" = "오른쪽 Shift 단독";
"Esc" = "Esc";
"Shift+Esc" = "Shift+Esc";
"Tap the right Alt (한/영 on Korean keyboards) on its own. Apps don't react to it." = "오른쪽 Alt(한국어 자판에서는 한/영 키)만 눌렀다 뗍니다. 앱은 이 키에 반응하지 않습니다.";
"Alt and Space together. It no longer opens the window menu." = "Alt와 Space를 함께. 더 이상 창 메뉴를 열지 않습니다.";
"Tap the right Shift on its own. Apps ignore it, so nothing else happens." = "오른쪽 Shift만 눌렀다 뗍니다. 앱은 이 키를 무시하므로 다른 일이 생기지 않습니다.";
"Quick, but some apps also see the Esc and may close a dialog or clear the input." = "빠르지만, 어떤 앱은 그 Esc도 받아서 대화상자를 닫거나 입력을 지울 수 있습니다.";
"A right Alt or Shift tap with other modifiers is left to what it's bound to." = "다른 modifier와 함께 누른 오른쪽 Alt·Shift는 받지 않고, 원래 하던 일에 맡깁니다.";

/* 일시정지 */
"Right Ctrl tap" = "오른쪽 Ctrl 단독";
"Right Win tap" = "오른쪽 Win 단독";
"Right Ctrl tap (한자 on Korean keyboards)" = "오른쪽 Ctrl 단독 (한국어 자판에서는 한자 키)";
"Add Ctrl, Alt or Win: without one the key types. F-keys can go alone." = "Ctrl, Alt, Win 중 하나를 함께 누르세요. 없으면 글자가 입력됩니다. F 키는 혼자 써도 됩니다.";
"Press Esc to cancel." = "취소하려면 Esc를 누르세요.";

/* 일본어 */
"A full-width space after Japanese; Shift+Space types the other width." = "일본어 뒤의 공백을 전각으로 씁니다. Shift+Space는 반대 폭입니다.";

/* 앱별 */
"Add an app by its program name, such as notepad.exe." = "notepad.exe처럼 프로그램 이름으로 앱을 추가하세요.";
"Program name" = "프로그램 이름";
"Running apps" = "실행 중인 앱";
"Custom" = "직접 고르기";
"Full-width" = "전각";

/* 입력해 보기 */
"Language" = "언어";
"Confidence" = "확신도";
"Why" = "근거";
"Type here on the English layout, e.g. dkssud hello" = "영문 자판으로 여기에 쳐 보세요. 예: dkssud hello";
"The language switch key changes the word's reading, also right after the word." = "언어 바꾸기 키로 단어의 읽기를 바꿀 수 있습니다. 단어를 친 바로 뒤에도 됩니다.";
"How it was decided" = "어떻게 판단했나";
"Add to Dictionary…" = "사전에 추가…";
"Clear" = "지우기";
"Type a word above to see its scores." = "위에 단어를 치면 점수가 나옵니다.";

/* 정보 */
"Settings files" = "설정 파일";
"Open Settings Folder" = "설정 폴더 열기";
"Settings, per-app rules and the dictionary are JSON files in this folder." = "설정, 앱별 규칙, 사전은 이 폴더의 JSON 파일입니다.";
"Downloading… The installer opens when it's done." = "내려받는 중… 다 받으면 설치 프로그램이 열립니다.";
"The downloaded installer isn't signed by Araso's developer, so it was deleted." = "내려받은 설치 프로그램이 Araso 개발자의 서명이 아니어서 지웠습니다.";
"This copy isn't signed, so updates open the release page." = "이 사본은 서명되지 않아, 업데이트는 릴리스 페이지에서 받습니다.";
"Removes Araso from this PC. The uninstaller asks whether to delete settings and learned words too." = "이 PC에서 Araso를 지웁니다. 설정과 학습한 단어도 지울지는 제거 프로그램이 묻습니다.";
"Araso isn't installed here, so it can't be uninstalled from this window." = "이 위치에 설치된 Araso가 아니어서 여기서는 제거할 수 없습니다.";
"Araso Settings" = "Araso 설정";
